rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Segurança e Baixo Custo $O(1)$)
    // =========================================================================
    
    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário é Super Admin (via Custom Claim ou E-mail verificado)
    function isSuperAdmin() {
      return isAuthenticated() && 
        (request.auth.token.role == 'superadmin' || 
         request.auth.token.email == 'adailton.medeiros@gmail.com');
    }

    // Verifica se o usuário é o próprio dono do recurso
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário possui papel de Líder (Admin de Grupo) via Custom Claim ou documento do grupo
    function isGroupAdmin(groupId) {
      return isAuthenticated() && 
        (isSuperAdmin() || request.auth.token.role == 'admin' || request.auth.token.groupId == groupId);
    }

    // =========================================================================
    // REGRAS DAS COLEÇÕES E SUBCOLEÇÕES HIERÁRQUICAS
    // =========================================================================

    // 1. Usuários — Leitura restrita ao próprio usuário ou Super Admin (Conformidade LGPD)
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isSuperAdmin());
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 2. Grupos de Compra Coletiva
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (isSuperAdmin() || resource.data.adminId == request.auth.uid);
      allow delete: if isSuperAdmin();

      // 3. Subcoleção Hierárquica: Pedidos / Lotes do Grupo
      match /orders/{orderId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isGroupAdmin(groupId);

        // 4. Subcoleção Hierárquica: Participações no Lote
        match /participations/{participationId} {
          allow read: if isAuthenticated() && 
            (resource.data.userId == request.auth.uid || isGroupAdmin(groupId));
          allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAuthenticated() && 
            (resource.data.userId == request.auth.uid || isGroupAdmin(groupId));
        }
      }
    }

    // 5. Fornecedores (Suppliers) — Perfil público para exibição; criação/edição restrita
    match /fornecedores/{supplierId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isSuperAdmin() || request.auth.token.role == 'supplier');
      allow update, delete: if isAuthenticated() && (isSuperAdmin() || (isOwner(supplierId) && request.auth.token.role == 'supplier'));
    }

    // 6. Produtos dos Fornecedores
    match /products/{productId} {
      allow read: if true; // Leitura pública para visitantes
      allow create, update, delete: if isAuthenticated() && (isSuperAdmin() || request.auth.token.role == 'supplier');
    }

    // 7. Avaliações e Reviews da Comunidade
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || resource.data.userId == request.auth.uid;
    }
  }
}

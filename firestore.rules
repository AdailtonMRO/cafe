rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // HELPER FUNCTIONS (Segurança e Baixo Custo O(1))
    // =========================================================================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se o usuário é Super Admin (via Custom Claim ou E-mail verificado)
    function isSuperAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'superadmin' ||
         request.auth.token.email == 'adailton.medeiros@gmail.com');
    }

    // Verifica se o usuário é o próprio dono do recurso
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Verifica se o usuário possui papel de Líder (Admin de Grupo) via Custom Claim
    function isGroupAdmin(groupId) {
      return isAuthenticated() &&
        (isSuperAdmin() ||
         request.auth.token.role == 'admin' ||
         request.auth.token.groupId == groupId);
    }

    // =========================================================================
    // COLEÇÕES RAIZ HIERÁRQUICAS (principal)
    // =========================================================================

    // 1. Usuários — Leitura restrita ao próprio usuário, admins do grupo, ou Super Admin (LGPD)
    match /users/{userId} {
      allow read: if isAuthenticated() && (
        isOwner(userId) ||
        isSuperAdmin() ||
        // Admins de grupo podem ler membros do mesmo grupo para gerenciamento
        request.auth.token.role == 'admin'
      );
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && (isOwner(userId) || isSuperAdmin());
      allow delete: if isSuperAdmin();
    }

    // 2. Grupos de Compra Coletiva
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
        (isSuperAdmin() || resource.data.adminId == request.auth.uid);
      allow delete: if isSuperAdmin();

      // 2a. Subcoleção: Pedidos/Lotes do Grupo
      match /orders/{orderId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isGroupAdmin(groupId);

        // 2b. Subcoleção: Participações no Lote
        match /participations/{participationId} {
          allow read: if isAuthenticated() &&
            (resource.data.userId == request.auth.uid || isGroupAdmin(groupId));
          allow create: if isAuthenticated() &&
            request.resource.data.userId == request.auth.uid;
          allow update, delete: if isAuthenticated() &&
            (resource.data.userId == request.auth.uid || isGroupAdmin(groupId));
        }
      }
    }

    // =========================================================================
    // COLEÇÕES RAIZ LEGADAS (fallback para compatibilidade com dados existentes)
    // O app.js ainda consulta estas coleções enquanto a migração para subcoleções
    // hierárquicas não é concluída para todos os dados.
    // =========================================================================

    // 3. Pedidos (coleção raiz legada — migrar para groups/{gId}/orders)
    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        (isSuperAdmin() || request.auth.token.role == 'admin');
      allow delete: if isSuperAdmin();
    }

    // 4. Participações (coleção raiz legada — migrar para groups/{gId}/orders/{oId}/participations)
    match /participations/{participationId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.role == 'admin' ||
        isSuperAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.role == 'admin' ||
        isSuperAdmin()
      );
      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
    }

    // 5. Fornecedores
    match /fornecedores/{supplierId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
        (isSuperAdmin() || request.auth.token.role == 'supplier');
      allow update, delete: if isAuthenticated() &&
        (isSuperAdmin() || (isOwner(supplierId) && request.auth.token.role == 'supplier'));
    }

    // 6. Produtos dos Fornecedores (leitura pública para visitantes)
    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAuthenticated() &&
        (isSuperAdmin() || request.auth.token.role == 'supplier');
    }

    // 7. Avaliações e Reviews da Comunidade
    match /reviews/{reviewId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() ||
        resource.data.userId == request.auth.uid;
    }

    // 8. Histórico de Fornecedores
    match /supplier_history/{histId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() &&
        (isSuperAdmin() || request.auth.token.role == 'admin');
      allow delete: if isSuperAdmin();
    }

    // 9. Solicitações de Grupo (group_requests)
    match /group_requests/{requestId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isSuperAdmin()
      );
      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isSuperAdmin();
    }
  }
}
